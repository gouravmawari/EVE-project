# Copy this file to .env.docker and replace every placeholder locally.
POSTGRES_USER=diagnostics_app
# Use only URL-safe unencoded characters: [A-Za-z0-9._~-].
# Do not use @, :, /, ?, #, %, or spaces.
POSTGRES_PASSWORD=replace-with-a-local-url-safe-password
POSTGRES_DB=diagnostics
API_PORT=3001
JWT_SECRET=replace-with-a-long-local-jwt-secret
WEBHOOK_SECRET=replace-with-a-long-local-webhook-secret

# Leave both blank to skip seeding, or set both to seed/promote one admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
