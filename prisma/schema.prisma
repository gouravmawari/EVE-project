generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  role Role @default(USER)
  createdAt DateTime @default(now())
  bookings Booking[]
}
model DiagnosticCentre {
  id String @id @default(uuid())
  name String
  address String
  tests DiagnosticTest[]
  bookings Booking[]
  createdAt DateTime @default(now())
}
model DiagnosticTest {
  id String @id @default(uuid())
  name String
  price Decimal @db.Decimal(12,2)
  centreId String
  centre DiagnosticCentre @relation(fields:[centreId], references:[id], onDelete:Restrict)
  bookings Booking[]
  @@index([centreId])
}
model Booking {
  id String @id @default(uuid())
  userId String
  centreId String
  testId String
  appointmentAt DateTime
  amount Decimal @db.Decimal(12,2)
  status BookingStatus @default(PENDING)
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  centre DiagnosticCentre @relation(fields:[centreId], references:[id], onDelete:Restrict)
  test DiagnosticTest @relation(fields:[testId], references:[id], onDelete:Restrict)
  payment Payment?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([centreId, testId])
  @@unique([userId, centreId, testId, appointmentAt])
}
model Payment {
  id String @id @default(uuid())
  bookingId String @unique
  status PaymentStatus @default(PENDING)
  providerReference String?
  booking Booking @relation(fields:[bookingId], references:[id], onDelete:Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model WebhookEvent {
  id String @id @default(uuid())
  providerEventId String @unique
  payloadHash String
  createdAt DateTime @default(now())
}
